# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env a Git.

# Contraseña de la cámara ELITH SECURITYCAM (usuario fijo: elith1)
CAMERA_PASSWORD=

# URL del broker MQTT (Mosquitto, vía docker-compose)
MQTT_URL=mqtt://localhost:1883

# Prefijo de topics que publica Frigate (debe coincidir con
# frigate/config/config.yml -> mqtt.topic_prefix)
FRIGATE_TOPIC_PREFIX=frigate
