# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env a Git.

# Contraseña de la cámara ELITH SECURITYCAM (usuario fijo: elith1)
CAMERA_PASSWORD=

# URL del broker MQTT (Mosquitto, vía docker-compose)
MQTT_URL=mqtt://localhost:1883

# Prefijo de topics que publica Frigate (debe coincidir con
# frigate/config/config.yml -> mqtt.topic_prefix)
FRIGATE_TOPIC_PREFIX=frigate
FRIGATE_URL=http://localhost:5000
FRIGATE_CAMERA=elith_cam_1

# Operational Intelligence provider
AI_PROVIDER=ollama
AI_TIMEOUT_MS=
AI_SEED=42

# Experimental provider retained as the default until model evaluation.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=60000
OLLAMA_SEED=42

# Optional OpenAI-compatible local runtime (for example llama.cpp server).
# No API key is required for a local server unless it is configured to require one.
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8080/v1
OPENAI_COMPATIBLE_MODEL=local-model
OPENAI_COMPATIBLE_API_KEY=
